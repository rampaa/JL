<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PackageId>JL.Windows</PackageId>
    <AssemblyName>JL</AssemblyName>
    <NoWin32Manifest>true</NoWin32Manifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--Do not update HandyControl to 3.5.0 or 3.5.1, see: https://github.com/HandyOrg/HandyControl/issues/1524-->
    <PackageReference Include="HandyControl" Version="3.4.0" />
    <PackageReference Include="HandyControl.Lang.en" Version="3.4.0" />

    <PackageReference Include="System.Speech" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="JL.exe.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="update-helper.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../Docs/**/*">
      <Link>Docs/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../JL.Core/JL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
    <DefineConstants>$(DefineConstants);X86</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
    <DefineConstants>$(DefineConstants);ARM64</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <_SdkTrimOutputDir Condition="'$(PublishDir)' != ''">$(PublishDir)</_SdkTrimOutputDir>
    <_SdkTrimOutputDir Condition="'$(_SdkTrimOutputDir)' == ''">$(TargetDir)</_SdkTrimOutputDir>
    <_SdkTrimOutputDir>$(_SdkTrimOutputDir.TrimEnd('\'))</_SdkTrimOutputDir>
    <_SdkTrimStagingDir>$(_SdkTrimOutputDir)\SdkTrimStaging</_SdkTrimStagingDir>
    <_SdkTrimRspFile>$(_SdkTrimOutputDir)\illink_args.rsp</_SdkTrimRspFile>
  </PropertyGroup>

  <Target Name="TrimSDK" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">

    <RemoveDir Directories="$(_SdkTrimStagingDir)" />
    <MakeDir Directories="$(_SdkTrimStagingDir)" />

    <ItemGroup>
      <_SdkTrimReference Include="@(ReferencePath)" Condition="'%(Filename)' != 'Microsoft.Windows.SDK.NET'" />
      <_SdkTrimRspLines Include="-a;&quot;$(_SdkTrimOutputDir)\$(TargetName).dll&quot;" />
      <_SdkTrimRspLines Include="-d;&quot;$(_SdkTrimOutputDir)&quot;" />
      <_SdkTrimRspLines Include="-out;&quot;$(_SdkTrimStagingDir)&quot;" />
      <_SdkTrimRspLines Include="--action;copy;--action;link;Microsoft.Windows.SDK.NET;--action;link;WinRT.Runtime" />
      <_SdkTrimRspLines Include="--skip-unresolved;true;--disable-opt;unreachablebodies" />
      <_SdkTrimRspLines Include="--warn;0" />
      <_SdkTrimRspLines Include="-reference;&quot;%(_SdkTrimReference.Identity)&quot;" />
    </ItemGroup>

    <WriteLinesToFile File="$(_SdkTrimRspFile)" Lines="@(_SdkTrimRspLines)" Overwrite="true" />
    <Exec Command="dotnet &quot;$([System.IO.Path]::GetDirectoryName('$(ILLinkTasksAssembly)'))\illink.dll&quot; @&quot;$(_SdkTrimRspFile)&quot;" />

    <Copy SourceFiles="$(_SdkTrimStagingDir)\Microsoft.Windows.SDK.NET.dll;$(_SdkTrimStagingDir)\WinRT.Runtime.dll" DestinationFolder="$(_SdkTrimOutputDir)" OverwriteReadOnlyFiles="true" />

    <RemoveDir Directories="$(_SdkTrimStagingDir)" />
    <Delete Files="$(_SdkTrimRspFile)" />
  </Target>

</Project>
